defmodule <%= @module %> do
  @moduledoc """
  The <%= @name %> UCP handler, generated by `mix bazaar.gen.handler`.

  `bazaar_routes "/", <%= @module %>` in your router serves every capability
  below from `<%= @shop %>` (your products, rates and rules) and
  `Bazaar.Store.ETS` (where checkouts, carts and orders live until you move
  them to your database). Override any callback here when a default in
  `Bazaar.Handler.Defaults` doesn't fit.
  """

  use Bazaar.Handler, shop: <%= @shop %>, store: Bazaar.Store.ETS

  @impl true
  def capabilities, do: <%= inspect(@capabilities) %>

  @impl true
  def business_profile do
    %{
      "name" => <%= inspect(@name) %>,
      "description" => "TODO: what you sell, in one line",
      # TODO: the payment handlers you accept, for example
      # %{"name" => "com.stripe", "id" => "stripe", "config" => %{}}
      "payment_handlers" => []
    }
  end
end
