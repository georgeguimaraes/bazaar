defmodule <%= @module %> do
  @moduledoc """
  The <%= @name %> UCP handler, generated by `mix bazaar.gen.handler`.

  `bazaar_routes "/", <%= @module %>` in your router serves discovery<%= if @cart?, do: ", carts" %><%= if @catalog?, do: ", the catalog" %>,
  checkouts<%= if @orders?, do: " and orders" %> from these callbacks. The protocol rules live in
  bazaar (`Bazaar.Checkout`<%= if @cart?, do: ", `Bazaar.Cart`" %><%= if @catalog?, do: ", `Bazaar.Catalog`" %><%= if @orders?, do: ", `Bazaar.Order`" %>);
  the functions under "Your store" at the bottom are placeholders so the app
  answers on first boot. Replace them with your catalog, rates and storage.
  """

  use Bazaar.Handler

  alias Bazaar.Checkout
  alias <%= @store %>

  @impl true
  def capabilities, do: <%= inspect(@capabilities) %>

  @impl true
  def business_profile do
    %{
      "name" => <%= inspect(@name) %>,
      "description" => "TODO: what you sell, in one line",
      # TODO: the payment handlers you accept, for example
      # %{"name" => "com.stripe", "id" => "stripe", "config" => %{}}
      "payment_handlers" => []
    }
  end
<%= if @cart? do %>
  # Carts

  @impl true
  def create_cart(params, _conn) do
    state = Bazaar.Cart.new(params)
    Store.put_cart(state)
    {:ok, build_cart(state)}
  end

  @impl true
  def get_cart(id, _conn) do
    case Store.get_cart(id) do
      nil -> {:error, :not_found}
      state -> {:ok, build_cart(state)}
    end
  end

  @impl true
  def update_cart(id, params, _conn) do
    case Store.get_cart(id) do
      nil -> {:error, :not_found}
      state -> {:ok, state |> Bazaar.Cart.apply_update(params) |> Store.put_cart() |> build_cart()}
    end
  end

  @impl true
  def cancel_cart(id, _conn) do
    case Store.get_cart(id) do
      nil ->
        {:error, :not_found}

      state ->
        Store.delete_cart(id)
        {:ok, build_cart(state)}
    end
  end

  defp build_cart(state) do
    Bazaar.Cart.build(state,
      item: &item/1,<%= if @discount? do %>
      discount: &discount/2,<% end %>
      continue_url: base_url() <> "/carts/" <> state.id
    )
  end
<% end %>
  # Checkouts
<%= if @cart? do %>
  # A checkout from a cart: the cart's contents win over the payload, and a
  # cart converts once, so a repeat answers the checkout it already has.
  @impl true
  def create_checkout(%{"cart_id" => cart_id} = params, conn) do
    case {Store.get_checkout_for_cart(cart_id), Store.get_cart(cart_id)} do
      {checkout_id, _cart} when is_binary(checkout_id) ->
        get_checkout(checkout_id, conn)

      {nil, nil} ->
        {:error, :not_found}

      {nil, cart} ->
        state = Checkout.from_cart(cart, params, stored_addresses: &stored_addresses/1)
        Store.put_checkout(state)
        Store.put_checkout_for_cart(cart_id, state.id)
        {:ok, build(state)}
    end
  end
<% else %>
  @impl true<% end %>
  def create_checkout(params, _conn) do
    state = Checkout.new(params, stored_addresses: &stored_addresses/1)
    Store.put_checkout(state)
    {:ok, build(state)}
  end

  @impl true
  def get_checkout(id, _conn) do
    case Store.get_checkout(id) do
      nil -> {:error, :not_found}
      state -> {:ok, build(state)}
    end
  end

  @impl true
  def update_checkout(id, params, _conn) do
    with {:ok, state} <- open_checkout(id) do
      state = Checkout.apply_update(state, params, stored_addresses: &stored_addresses/1)
      Store.put_checkout(state)
      {:ok, build(state)}
    end
  end

  @impl true
  def cancel_checkout(id, _conn) do
    case Store.get_checkout(id) do
      nil -> {:error, :not_found}
      %{status: :completed} -> {:error, :invalid_state}
      state -> {:ok, state |> Map.put(:status, :canceled) |> Store.put_checkout() |> build()}
    end
  end

  @impl true
  def complete_checkout(id, conn) do
    with {:ok, state} <- open_checkout(id) do
      state = Checkout.apply_update(state, conn.body_params, stored_addresses: &stored_addresses/1)
      Store.put_checkout(state)
      checkout = build(state)

      cond do<%= if @fulfillment? do %>
        not Checkout.fulfillment_ready?(checkout) ->
          message =
            Checkout.error(
              "missing",
              "A fulfillment destination and option must be selected",
              "$.fulfillment"
            )

          {:ok, build(state, [message])}
<% end %>
        Enum.any?(checkout["messages"], &(&1["type"] == "error")) ->
          {:ok, checkout}

        true ->
          authorize_and_complete(state, checkout)
      end
    end
  end

  defp authorize_and_complete(state, checkout) do
    case authorize(state.instruments) do
      :ok ->
        complete(state, checkout)

      {:error, reason} ->
        {:ok, build(state, [Checkout.error("payment_failed", reason, "$.payment")])}
    end
  end
<%= if @orders? do %>
  defp complete(state, checkout) do
    order_id = "order_" <> Store.id()
    order = Bazaar.Order.from_checkout(checkout, order_id, base_url() <> "/orders/" <> order_id)
    Store.put_order(order)

    state = %{state | status: :completed, order_id: order_id}
    Store.put_checkout(state)

    # TODO: tell the platform about the order and its later events with
    # Bazaar.Webhook.deliver/2 (see the handlers guide, "Sending Order Events").
    {:ok, build(state)}
  end

  # Orders

  @impl true
  def get_order(id, _conn) do
    case Store.get_order(id) do
      nil -> {:error, :not_found}
      order -> {:ok, order}
    end
  end

  @impl true
  def update_order(id, params, _conn) do
    with %{} = order <- Store.get_order(id) || {:error, :not_found},
         {:ok, order} <- Bazaar.Order.apply_update(order, params) do
      {:ok, Store.put_order(order)}
    end
  end

  @impl true
  def cancel_order(id, _conn) do
    case Store.get_order(id) do
      nil -> {:error, :not_found}
      # TODO: cancel what your fulfillment allows; the order document gets its events
      _order -> {:error, :invalid_state}
    end
  end
<% else %>
  defp complete(state, _checkout) do
    state = %{state | status: :completed}
    Store.put_checkout(state)
    {:ok, build(state)}
  end
<% end %><%= if @catalog? do %>
  # Catalog

  @impl true
  def search_products(params, _conn) do
    products =
      products()
      |> Enum.filter(&matches?(&1, params["query"]))
      |> Bazaar.Catalog.filter(params["filters"])

    {page, pagination} = Bazaar.Catalog.paginate(products, params["pagination"])
    {:ok, %{"products" => page, "pagination" => pagination}}
  end

  defp matches?(_product, query) when query in [nil, ""], do: true

  defp matches?(product, query) do
    query = String.downcase(query)

    String.contains?(String.downcase(product["title"]), query) or
      String.contains?(String.downcase(product["description"]["plain"] || ""), query)
  end

  @impl true
  def lookup_products(%{"ids" => ids} = params, _conn) do
    {products, _unknown} = Bazaar.Catalog.lookup(products(), ids)
    {:ok, %{"products" => Bazaar.Catalog.filter(products, params["filters"])}}
  end

  @impl true
  def get_product(%{"id" => id} = params, _conn) do
    case Bazaar.Catalog.find(products(), id) do
      nil ->
        {:error, :not_found}

      product ->
        detail =
          Bazaar.Catalog.detail_product(product, params["selected"],
            preferences: params["preferences"]
          )

        {:ok, %{"product" => detail}}
    end
  end
<% end %>
  defp open_checkout(id) do
    case Store.get_checkout(id) do
      nil -> {:error, :not_found}
      %{status: :open} = state -> {:ok, state}
      _closed -> {:error, :invalid_state}
    end
  end

  defp build(state, messages \\ []) do
    Checkout.build(state,
      item: &item/1,<%= if @fulfillment? do %>
      fulfillment_options: &fulfillment_options/2,<% end %><%= if @discount? do %>
      discount: &discount/2,<% end %>
      payment_handlers: payment_handlers(),
      links: [
        %{"type" => "privacy_policy", "url" => base_url() <> "/privacy"},
        %{"type" => "terms_of_service", "url" => base_url() <> "/terms"}
      ],
      order_url: &(base_url() <> "/orders/" <> &1),
      messages: messages
    )
  end

  # Your store
  #
  # Placeholder data so the app answers on first boot. Replace each function
  # with your catalog, rates, promotions, customers and payment provider.

  # TODO: your products in the spec's shape. Variants are what gets bought:
  # a variant's id is the item id a checkout receives.
  def products do
    [
      %{
        "id" => "sample",
        "title" => "Sample product",
        "description" => %{"plain" => "Replace me with your catalog"},
        "price_range" => %{
          "min" => %{"amount" => 1000, "currency" => "USD"},
          "max" => %{"amount" => 1000, "currency" => "USD"}
        },
        "variants" => [
          %{
            "id" => "sample",
            "title" => "Sample product",
            "description" => %{"plain" => "Replace me with your catalog"},
            "price" => %{"amount" => 1000, "currency" => "USD"},
            "availability" => %{"available" => true}
          }
        ]
      }
    ]
  end

  # What a line item costs and how many you can sell (`stock: nil` is unlimited).
  defp item(id) do
    with %{"variants" => variants} <- Bazaar.Catalog.find(products(), id),
         %{"title" => title, "price" => %{"amount" => amount}} <-
           Enum.find(variants, &(&1["id"] == id)) || hd(variants) do
      %{item: %{"title" => title, "price" => amount}, stock: nil}
    else
      _ -> nil
    end
  end
<%= if @fulfillment? do %>
  # TODO: the options for a destination; `context` has the priced line items and subtotal.
  defp fulfillment_options(_destination, _context) do
    [
      %{
        "id" => "standard",
        "title" => "Standard shipping",
        "totals" => [%{"type" => "total", "amount" => 500}]
      }
    ]
  end
<% end %><%= if @discount? do %>
  # TODO: what a code is worth on the running total, `nil` for an unknown code.
  defp discount(_code, _running_total), do: nil
<% end %>
  # TODO: stored addresses for a known buyer, injected into fulfillment methods.
  defp stored_addresses(_buyer), do: nil

  # TODO: charge the instruments through your payment provider.
  defp authorize([]), do: {:error, "A payment instrument is required"}
  defp authorize(_instruments), do: :ok

  # TODO: the payment handler registry advertised on checkouts, keyed by
  # reverse-DNS name, matching business_profile/0.
  defp payment_handlers, do: %{}

  defp base_url, do: Application.get_env(<%= inspect(@app) %>, :bazaar_base_url, "http://localhost:4000")
end
